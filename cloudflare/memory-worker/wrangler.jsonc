{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "qoqbot-memory",
	"main": "src/index.js",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qoqbot-memory",
			"database_id": "c0facadd-953f-49f7-92e3-13b257053627",
			"migrations_dir": "migrations"
		}
	],
	"vectorize": [
		{
			"binding": "MEMORY_INDEX",
			"index_name": "qoqbot-memory"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	}
}
